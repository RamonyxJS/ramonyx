{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx TODO backlog",
  "description": "SUMBER TUNGGAL backlog prioritas menuju paritas kompetitif. TODO.md adalah hasil generate (scripts/docs/todo.ts); jangan mengedit TODO.md manual. Item berasal dari analisis kesenjangan docs/PLAN-docs-consolidation.md §3.",
  "type": "object",
  "required": ["schemaVersion", "items"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "theme", "priority", "size", "status", "what", "why", "done", "areas", "competitor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "theme": {
            "enum": ["routing", "rendering", "data", "security", "dx", "deploy", "docs", "ecosystem", "perf", "quality"]
          },
          "priority": { "enum": ["p0", "p1", "p2", "p3"] },
          "size": { "enum": ["S", "M", "L"] },
          "status": { "enum": ["open", "in-progress", "done"] },
          "what": { "type": "string", "minLength": 20 },
          "why": { "type": "string", "minLength": 20 },
          "done": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 10 } },
          "areas": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "adrs": { "type": "array", "items": { "type": "string" } },
          "competitor": { "type": "string", "minLength": 10 },
          "dependsOn": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
          "quickWin": { "type": "boolean" },
          "strategic": { "type": "boolean" },
          "source": { "type": "string" }
        }
      }
    }
  }
}
