{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx CLI reference (generated)",
  "description": "Referensi CLI `ramonyx`, diekstrak dari output `ramonyx help` oleh `pnpm docs:generate` (scripts/docs/cli.ts). Sumber kebenaran = kode CLI.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "usage", "commands", "flags"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 10 },
    "usage": { "type": "string", "minLength": 10 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+$" },
          "summary": { "type": "string", "minLength": 5 }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["flag", "argument", "description"],
        "additionalProperties": false,
        "properties": {
          "flag": { "type": "string", "pattern": "^--[a-z-]+$" },
          "argument": { "type": ["string", "null"] },
          "description": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
