{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx security controls",
  "description": "Model ancaman & kebijakan keamanan terstruktur: kontrol, status, bukti, celah. Dokumen manusia (docs/security/threat-model.md, asvs-mapping.md) tetap ada dan merujuk ke berkas ini.",
  "type": "object",
  "required": ["schemaVersion", "controls"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "control", "status", "evidence", "gaps"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^sec-[a-z0-9-]+$" },
          "control": { "type": "string", "minLength": 10 },
          "status": { "enum": ["implemented", "partial", "missing", "app-responsibility"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "gaps": { "type": "array", "items": { "type": "string", "minLength": 3 } },
          "adrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } }
        }
      }
    }
  }
}
