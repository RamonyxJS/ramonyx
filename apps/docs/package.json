{
  "name": "ramonyx-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Ramonyx public site (dogfood: SSR React + hydration; docs/public only)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node --import ../../tools/register.mjs ../../packages/devtools/src/cli.ts build --app .",
    "start": "NODE_ENV=production node --import ../../tools/register.mjs ../../packages/devtools/src/cli.ts start --app .",
    "dev": "node --import ../../tools/register.mjs ../../packages/devtools/src/cli.ts dev --app ."
  },
  "dependencies": {
    "@ramonyx/adapter-runtime": "workspace:*",
    "@ramonyx/bundler": "workspace:*",
    "@ramonyx/compiler": "workspace:*",
    "@ramonyx/react": "workspace:*",
    "@ramonyx/security": "workspace:*",
    "@ramonyx/server": "workspace:*",
    "@ramonyx/ssr": "workspace:*",
    "marked": "^18.1.1",
    "ramonyx": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
