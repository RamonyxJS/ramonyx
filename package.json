{
  "name": "ramonyx-monorepo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --import ./tools/register.mjs --test --test-timeout=120000 --test-force-exit \"packages/*/test/**/*.test.ts\" \"packages/*/test/**/*.test.tsx\" \"apps/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.tsx\" \"tests/**/*.test.ts\" \"benchmarks/**/*.test.ts\"",
    "build": "node --import ./tools/register.mjs packages/devtools/src/cli.ts build --app apps/playground",
    "bench": "node --import ./tools/register.mjs benchmarks/http/bench.ts",
    "bench:security": "node --import ./tools/register.mjs benchmarks/security/abuse.ts",
    "bench:ssr": "NODE_ENV=production node --expose-gc --import ./tools/register.mjs benchmarks/ssr/bench.tsx",
    "dev": "node --import ./tools/register.mjs packages/devtools/src/cli.ts dev --app apps/playground",
    "start": "NODE_ENV=production node --import ./tools/register.mjs packages/devtools/src/cli.ts start --app apps/playground",
    "test:e2e": "pnpm build && playwright test",
    "release": "node scripts/release.mjs",
    "release:build": "node scripts/build-packages.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "create:app": "node --import ./tools/register.mjs apps/create-app/src/cli.ts",
    "docs": "node --import ./tools/register.mjs packages/devtools/src/cli.ts build --app apps/docs && NODE_ENV=production node --import ./tools/register.mjs packages/devtools/src/cli.ts start --app apps/docs",
    "docs:validate": "node --import ./tools/register.mjs scripts/docs/validate.ts",
    "docs:generate": "node --import ./tools/register.mjs scripts/docs/generate-all.ts",
    "docs:stats": "node --import ./tools/register.mjs scripts/docs/stats.ts",
    "bench:report": "node --import ./tools/register.mjs benchmarks/http/bench.ts --out benchmarks/results/latest-http.json --compare --tolerance-pct 25",
    "bench:ssr:report": "NODE_ENV=production node --expose-gc --import ./tools/register.mjs benchmarks/ssr/bench.tsx --out benchmarks/results/latest-ssr.json --compare --tolerance-pct 25",
    "bench:gate": "pnpm bench:report --strict && pnpm bench:ssr:report --strict",
    "docs:export": "NODE_ENV=production node --import ./tools/register.mjs apps/docs/export.ts",
    "test:edge": "node --import ./tools/register.mjs scripts/edge-smoke.ts",
    "bench:image": "node benchmarks/vitals/image-pipeline.mjs",
    "docs:no-leak": "node scripts/verify-no-leak.mjs",
    "test:docs": "NODE_ENV=production node --import ./tools/register.mjs apps/docs/export.ts --origin https://ramonyx.example && playwright test --config apps/docs/playwright.config.ts",
    "build:worker": "node --import ./tools/register.mjs scripts/build-worker.ts",
    "deploy:worker": "pnpm build:worker && pnpm dlx wrangler deploy",
    "test:coverage": "node scripts/test-coverage.mjs",
    "eval:ai": "node --import ./tools/register.mjs evals/ai/run.ts",
    "eval:ai:baseline": "node --import ./tools/register.mjs evals/ai/run.ts --solution reference --json --brief --out evals/ai/baseline-reference.json && (node --import ./tools/register.mjs evals/ai/run.ts --solution empty --json --brief --out evals/ai/baseline-empty.json || true)"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@ramonyx/adapter-runtime": "workspace:*",
    "@ramonyx/bundler": "workspace:*",
    "@ramonyx/compiler": "workspace:*",
    "@ramonyx/core": "workspace:*",
    "@ramonyx/react": "workspace:*",
    "@ramonyx/router": "workspace:*",
    "@ramonyx/schema": "workspace:*",
    "@ramonyx/security": "workspace:*",
    "@ramonyx/server": "workspace:*",
    "@ramonyx/ssr": "workspace:*",
    "@types/autocannon": "7.12.7",
    "@types/node": "26.6.5",
    "autocannon": "8.0.0",
    "drizzle-orm": "0.45.4",
    "esbuild": "0.28.2",
    "ramonyx": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "workerd": "^1.20261018.1"
  }
}
