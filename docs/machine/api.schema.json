{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx API reference (generated)",
  "description": "Nama ekspor per paket, diekstrak dari `packages/*/src/index.ts` oleh `pnpm docs:generate` (scripts/docs/api.ts). Bukan tanda tangan tipe — sumber tipe tetap kode.",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "packages"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "minLength": 10 },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "version", "source", "values", "types", "reexports"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 3 },
          "version": { "type": "string", "minLength": 3 },
          "source": { "type": "string", "minLength": 3 },
          "values": { "type": "array", "items": { "type": "string" } },
          "types": { "type": "array", "items": { "type": "string" } },
          "reexports": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
