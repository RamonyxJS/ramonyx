{
  "name": "ramonyx-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "node --import ./tools/register.mjs --test \"packages/*/test/**/*.test.ts\" \"packages/*/test/**/*.test.tsx\" \"apps/*/test/**/*.test.ts\" \"apps/*/test/**/*.test.tsx\"",
    "build": "node --import ./tools/register.mjs apps/playground/build.ts",
    "bench": "node --import ./tools/register.mjs benchmarks/http/bench.ts",
    "dev": "node --import ./tools/register.mjs apps/playground/src/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@ramonyx/adapter-runtime": "workspace:*",
    "@ramonyx/server": "workspace:*",
    "@types/autocannon": "7.12.7",
    "@types/node": "26.6.5",
    "autocannon": "8.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
