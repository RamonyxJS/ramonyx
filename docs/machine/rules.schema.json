{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx agent rules",
  "description": "Aturan + invarian untuk agen AI (dan manusia) yang menulis kode DI ATAS Ramonyx — audiens berbeda dari AGENTS.md (kontributor repo). Setiap aturan punya contoh benar/salah dan cara penegakan.",
  "type": "object",
  "required": ["schemaVersion", "rules"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rule", "rationale", "scope", "good", "bad", "enforcement"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "rule": { "type": "string", "minLength": 10 },
          "rationale": { "type": "string", "minLength": 10 },
          "scope": { "enum": ["app", "framework", "repo", "docs"] },
          "good": { "type": "string", "minLength": 3 },
          "bad": { "type": "string", "minLength": 3 },
          "enforcement": { "type": "string", "minLength": 3 },
          "adrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } }
        }
      }
    }
  }
}
