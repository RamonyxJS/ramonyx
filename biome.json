{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/.ramonyx",
      "!**/target",
      "!**/test-results",
      "!**/playwright-report",
      "!benchmarks/results",
      "!docs/public/machine",
      "!docs/internal/machine",
      "!TODO.md"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/src/**",
        "packages/router/src/**",
        "packages/schema/src/**",
        "packages/server/src/**",
        "packages/testing/src/**",
        "packages/ramonyx/src/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*"],
                    "message": "Hanya packages/adapter-runtime yang boleh mengimpor node:* (docs/architecture.md §4)"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
