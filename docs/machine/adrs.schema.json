{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ramonyx ADR index",
  "description": "Indeks ADR machine-readable. Metadata (id/file/title/status/date) DIPARSING dari berkas ADR dan diverifikasi dua arah oleh `pnpm docs:validate`; `decision` adalah ringkasan satu kalimat (kurasi) — teks ADR tetap otoritatif.",
  "type": "object",
  "required": ["schemaVersion", "adrs"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "adrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "title", "status", "date", "decision"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
          "file": { "type": "string" },
          "title": { "type": "string", "minLength": 3 },
          "status": { "enum": ["accepted", "proposed", "rejected", "superseded"] },
          "statusDetail": { "type": "string" },
          "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "decision": { "type": "string", "minLength": 10 },
          "related": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
          "updates": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
          "features": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } }
        }
      }
    }
  }
}
